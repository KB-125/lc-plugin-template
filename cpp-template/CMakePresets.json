{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "win-base",
            "hidden": true,
            "inherits": "base"
        },
        {
            "name": "win-debug",
            "inherits": "win-base",
            "displayName": "Windows Debug (Ninja / MSVC, 需 VS 开发者环境)",
            "generator": "Ninja",
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "win-release",
            "inherits": "win-base",
            "displayName": "Windows Release (Ninja / MSVC, 需 VS 开发者环境)",
            "generator": "Ninja",
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "cl.exe"
            }
        },
        {
            "name": "win-ci",
            "inherits": "base",
            "displayName": "Windows CI (Ninja / MSVC, 编译器来自环境)",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vs22-debug",
            "inherits": "win-base",
            "displayName": "Visual Studio 2022 Debug",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "vs19-debug",
            "inherits": "win-base",
            "displayName": "Visual Studio 2019 Debug",
            "generator": "Visual Studio 16 2019",
            "architecture": "x64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "base",
            "displayName": "Linux Debug (Ninja / GCC)",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "inherits": "base",
            "displayName": "Linux Release (Ninja / GCC)",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-arm64-debug",
            "inherits": "base",
            "displayName": "Linux ARM64 Debug (GCC cross)",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "aarch64-linux-gnu-gcc",
                "CMAKE_CXX_COMPILER": "aarch64-linux-gnu-g++",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/aarch64-linux-gnu.toolchain.cmake"
            }
        },
        {
            "name": "linux-arm64-release",
            "inherits": "linux-arm64-debug",
            "displayName": "Linux ARM64 Release (GCC cross)",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "win-debug",
            "configurePreset": "win-debug"
        },
        {
            "name": "win-release",
            "configurePreset": "win-release"
        },
        {
            "name": "vs22-debug",
            "configurePreset": "vs22-debug",
            "configuration": "Debug"
        },
        {
            "name": "vs19-debug",
            "configurePreset": "vs19-debug",
            "configuration": "Debug"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-arm64-debug",
            "configurePreset": "linux-arm64-debug"
        },
        {
            "name": "linux-arm64-release",
            "configurePreset": "linux-arm64-release"
        },
        {
            "name": "win-ci",
            "configurePreset": "win-ci"
        }
    ]
}